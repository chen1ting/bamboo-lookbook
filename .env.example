# Cloudflare R2 credentials (only needed for the real upload mode).
# For the dry-run mode (`node scripts/uploadPhoto.js <season> --dry-run`) this file can stay empty.

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=bamboo-lookbook

# Public base URL that serves the bucket (custom domain or r2.dev subdomain)
R2_PUBLIC_URL=https://img.yourdomain.com

# Optional: override the S3 endpoint. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
