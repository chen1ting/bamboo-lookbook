---
import Layout from '../layouts/Layout.astro';
import SocialIcon from './SocialIcon.astro';
import BambooIcon from './BambooIcon.astro';
import { t, type Lang } from '../i18n/utils';
import { site, socials } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// Direct contact rows, built once so the markup stays flat.
const details = [
  { label: tr('contact.emailLabel'), value: site.email, href: `mailto:${site.email}` },
  { label: tr('contact.phoneLabel'), value: site.phone, href: site.whatsapp },
  { label: tr('contact.hoursLabel'), value: tr('contact.hours') },
];
// Address is a multi-line string — one <span> per line.
const addressLines = tr('contact.address').split('\n');
---

<Layout lang={lang} title={`${tr('contact.title')} — BAMBOO`} description={tr('contact.subtitle')}>
 <section class="head container">
    <h1 class="title">{tr('contact.title')}</h1>
    <p class="lede">{tr('contact.subtitle')}</p>
 </section>

 <section class="grid container">
    <div class="details">
      {details.map((row) => (
        <div class="row">
          <span class="row-label">{row.label}</span>
          {row.href ? <a class="row-value" href={row.href}>{row.value}</a> : <span class="row-value">{row.value}</span>}
        </div>
      ))}

      <div class="row">
        <span class="row-label">{tr('contact.addressLabel')}</span>
        <span class="row-value">
          {addressLines.map((line) => <span class="line">{line}</span>)}
        </span>
      </div>
    </div>

    <div class="aside">
      <span class="mark" aria-hidden="true"><BambooIcon size={44} /></span>

      <h2 class="follow-title">{tr('contact.followTitle')}</h2>
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <SocialIcon name={s.key} />
              <span class="social-label">{s.label}</span>
              <span class="social-handle">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="note">{tr('contact.followNote')}</p>
    </div>
 </section>
</Layout>

<style>
  .head {
    padding-top: 92px;
    padding-bottom: 72px;
  }

  .title {
    font-size: clamp(2.2rem, 6.5vw, 4.4rem);
    letter-spacing: 0.08em;
    line-height: 1.1;
  }

  .lede {
    margin: 24px 0 0;
    max-width: 52ch;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    gap: 96px;
    align-items: start;
    padding-bottom: 56px;
  }

  .details {
    display: grid;
    gap: 34px;
    border-top: 1px solid var(--line);
    padding-top: 40px;
  }

  .row {
    display: grid;
    gap: 8px;
  }

  .row-label {
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .row-value {
    font-size: 1.05rem;
    color: var(--ink);
  }

  a.row-value {
    display: inline-block;
    width: fit-content;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  a.row-value:hover {
    color: var(--bamboo-dark);
    border-bottom-color: var(--bamboo-dark);
  }

  .line {
    display: block;
    line-height: 1.7;
  }

  .aside {
    border-top: 1px solid var(--line);
    padding-top: 40px;
  }

  .mark {
    display: block;
    color: var(--bamboo-light);
    opacity: 0.7;
  }

  .follow-title {
    margin-top: 28px;
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .socials {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .socials a {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition: color 0.4s var(--ease), padding-left 0.4s var(--ease);
  }

  .socials a:hover {
    color: var(--bamboo-dark);
    padding-left: 6px;
  }

  .social-label {
    font-size: 0.9rem;
  }

  .social-handle {
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .note {
    margin: 18px 0 0;
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--muted);
    opacity: 0.8;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }
  }

  @media (max-width: 760px) {
    .head {
      padding-top: 56px;
      padding-bottom: 44px;
    }
  }
</style>
