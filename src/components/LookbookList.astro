---
import { getCollection } from 'astro:content';
import { t, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// Newest season first; index 0 is advertised as "now available", the rest as archive.
const galleries = (await getCollection('galleries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="hero container">
 <h1 class="hero-title">{tr('home.title')}</h1>
 <p class="hero-sub">{tr('home.subtitle')}</p>
</section>

<section class="list container" id="process">
 <span class="stalk" aria-hidden="true"></span>

  {galleries.map((entry, index) => {
    const data = entry.data;
    const href = localizedPath(lang, `/collection/${data.season}`);
    const tag = index === 0 ? tr('home.tagNow') : tr('home.tagArchive');

    return (
      <article class="card">
        <a class="card-media" href={href} aria-label={data.seasonLabel[lang]}>
          <img
            src={data.coverImage}
            alt={data.seasonLabel[lang]}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </a>

        <span class="node" aria-hidden="true"></span>

        <div class="card-body">
          <span class="card-tag">{tag}</span>
          <h2 class="card-title">{data.seasonLabel[lang]}</h2>
          <a class="card-link" href={href}>
            <span>{tr('home.viewCollection')}</span>
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>
    );
  })}
</section>

<style>
  .hero {
    padding-top: 108px;
    padding-bottom: 88px;
    max-width: 1180px;
  }

  .hero-title {
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    letter-spacing: 0.08em;
    line-height: 1.05;
    color: var(--ink);
  }

  .hero-sub {
    margin: 22px 0 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 96px;
    padding-bottom: 40px;
  }

  /* the continuous culm running down the list — bamboo structure */
  .stalk {
    position: absolute;
    left: 32px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 240px) 1px minmax(0, 1fr);
    gap: 0 56px;
    align-items: stretch;
    padding-left: 0;
  }

  .card-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: rgba(74, 93, 69, 0.05);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card-media:hover img {
    transform: scale(1.03);
  }

  /* thin vertical divider between picture and copy + two bamboo nodes */
  .node {
    position: relative;
    width: 1px;
    background: var(--line);
  }

  .node::before,
  .node::after {
    content: '';
    position: absolute;
    left: -2.5px;
    width: 6px;
    height: 1.5px;
    background: var(--bamboo-light);
  }

  .node::before {
    top: 32%;
  }

  .node::after {
    top: 68%;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
    padding: 8px 0;
  }

  .card-tag {
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-title {
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    letter-spacing: 0.06em;
  }

  .card-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-left: 20px;
    font-size: 0.74rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bamboo-dark);
  }

  /* node-growth hover: a vertical stroke rises from the stem */
  .card-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 0;
    background: var(--bamboo-dark);
    transform: translateY(-50%);
    transition: height 0.4s var(--ease);
  }

  .card-link::after {
    content: '';
    position: absolute;
    left: -2px;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--bamboo-dark);
    transform: translateY(-50%) scale(0);
    transition: transform 0.4s var(--ease);
  }

  .card-link:hover::before {
    height: 26px;
  }

  .card-link:hover::after {
    transform: translateY(-50%) scale(1);
  }

  .arrow {
    transition: transform 0.4s var(--ease);
  }

  .card-link:hover .arrow {
    transform: translateX(5px);
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 68px;
      padding-bottom: 56px;
    }

    .stalk {
      left: 20px;
    }

    .list {
      gap: 64px;
    }

    .card {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-left: 18px;
    }

    .card-media {
      max-width: 320px;
    }

    .node {
      display: none;
    }

    .card-body {
      gap: 12px;
    }
  }
</style>
