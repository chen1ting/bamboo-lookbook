---
import Layout from '../../layouts/Layout.astro';
import LookbookList from '../../components/LookbookList.astro';
import { langPaths } from '../../lib/routes';
import { t, type Lang } from '../../i18n/utils';

// Real locales; the bare /lookbook URL is a redirect shim in src/pages/lookbook.astro.
export const getStaticPaths = () => langPaths();
---

<Layout lang={Astro.props.lang as Lang} title={`${t(Astro.props.lang as Lang)('home.title')} — BAMBOO`}>
 <LookbookList lang={Astro.props.lang as Lang} />
</Layout>